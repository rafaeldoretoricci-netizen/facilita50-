# Copie para .env.local e preencha. Nunca envie este arquivo preenchido para o GitHub.

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Suas integrações > Credenciais)
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta das notificações (Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
